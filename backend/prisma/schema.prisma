// Configuración de Prisma: generador de cliente + conexión a la base
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Nivel de membresía del usuario (gratis vs. planes pagos)
enum MembershipLevel {
  bronze
  silver
  gold
  diamond
}

model User {
  id        String   @id @default(uuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  // acá va el hash de bcrypt, nunca la contraseña en texto plano
  passwordHash String  @map("password_hash")

  avatarUrl String?  @map("avatar_url")
  coverUrl  String?  @map("cover_url")
  bio       String?
  birthDate DateTime? @map("birth_date") @db.Date
  country   String?
  city      String?

  membershipLevel MembershipLevel @default(bronze) @map("membership_level")
  isVerified      Boolean         @default(false) @map("is_verified")
  isActive        Boolean         @default(true)  @map("is_active")
  isPrivate       Boolean         @default(false) @map("is_private")
  commentPrivacy  CommentPrivacy  @default(everyone) @map("comment_privacy")
  termsAcceptedAt DateTime?       @map("terms_accepted_at")

  // recuperación de contraseña: token random + vencimiento, nunca guardamos la nueva sin hashear
  resetToken     String?   @map("reset_token")
  resetTokenExp  DateTime? @map("reset_token_exp")

  verificationToken    String?   @map("verification_token")
  verificationTokenExp DateTime? @map("verification_token_exp")

  // para el rate limiting / bloqueo por fuerza bruta que pediste
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  // ── privacidad del chat (global, mismo criterio que WhatsApp: si lo
  // ocultás, tampoco ves el de nadie más) ──
  showLastSeen     Boolean   @default(true) @map("show_last_seen")
  showReadReceipts Boolean   @default(true) @map("show_read_receipts")
  lastSeenAt       DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // ── relaciones ──
  memories  Memory[]
  familyMembers FamilyMember[]
  connectionsSent      Connection[]    @relation("ConnectionRequester")
  connectionsReceived  Connection[]    @relation("ConnectionAddressee")
  blocksMade           Block[]         @relation("BlockerRelation")
  blocksReceived       Block[]         @relation("BlockedRelation")
  conversationsIn      ConversationParticipant[]
  messagesSent         Message[]
  messageReactions     MessageReaction[]
  notificationsRecibidas Notification[] @relation("NotificationRecipient")
  notificationsGeneradas Notification[] @relation("NotificationActor")
  linkedFamilyNodes   FamilyMember[] @relation("FamilyLinkedUser")
  chapters       Chapter[]
  memoryReactions MemoryReaction[]
  memoryComments  MemoryComment[]
  commentReactions CommentReaction[]
  hiddenMemories HiddenMemory[] @relation("HiddenMemoriesByUser")
  mutesMade      Mute[]         @relation("MutesMade")
  mutedBy        Mute[]         @relation("MutedBy")
  savedMemories  SavedMemory[]  @relation("SavedMemoriesByUser")
  hiddenComments HiddenComment[] @relation("HiddenCommentsByUser")

  @@map("users") // el nombre real de la tabla en Postgres queda en minúscula y plural, como ya tenías

  reportsMade Report[] @relation("ReportsMade")
}

enum NotificationType {
  connection_request
  connection_accepted
  connection_rejected
  relation_type_proposed
  relation_type_accepted
  relation_type_rejected
  relation_type_cancelled
  reaction
  comment
  comment_reply
  family_link_proposed
  family_link_accepted
  family_link_rejected
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType

  // el último que generó el evento — sirve para mostrar su nombre/foto
  actorId   String?          @map("actor_id")
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  // agrupamiento: si varias personas reaccionan/comentan lo mismo, en vez
  // de crear una notificación por cada una, sumamos a la misma
  actorIds    String[]       @default([]) @map("actor_ids")
  actorsCount Int            @default(1)  @map("actors_count")

  entityType   String?  @map("entity_type") // "memory" | "connection"
  entityId     String?  @map("entity_id")
  reactionType String?  @map("reaction_type") // solo para type "reaction" — qué ícono mostrar

  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt       @map("updated_at")

  @@map("notifications")
}

enum MediaType {
  image
  video
}

model Memory {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  caption   String? @db.Text
  mediaKey  String? @map("media_key")   // el key que guarda storage.service.ts, no la URL
  mediaType MediaType? @map("media_type")

  chapterId String?  @map("chapter_id")
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  sharesCount Int @default(0) @map("shares_count")

  reactions MemoryReaction[]
  comments  MemoryComment[]
  hiddenBy HiddenMemory[] @relation("HiddenByUsers")
  savedBy  SavedMemory[]  @relation("SavedByUsers")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([userId, createdAt])
  @@map("memories")
}

enum Gender {
  male
  female
  other
}

model FamilyMember {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  firstName String   @map("first_name")
  lastName  String?  @map("last_name")
  gender    Gender?
  birthDate DateTime? @map("birth_date") @db.Date
  deathDate DateTime? @map("death_date") @db.Date
  photoKey  String?  @map("photo_key") // reusa el mismo storage.service.ts de Memories
  bio       String?  @db.Text
  // pisa el rol calculado automáticamente (Hermano, Abuela, etc.) cuando
  // el cálculo no contempla el parentesco real — vos decidís qué dice
  relacionManual String? @map("relacion_manual")

  motherId  String?  @map("mother_id")
  mother    FamilyMember?   @relation("MotherChildren", fields: [motherId], references: [id], onDelete: SetNull)
  childrenAsMother FamilyMember[] @relation("MotherChildren")

  fatherId  String?  @map("father_id")
  father    FamilyMember?   @relation("FatherChildren", fields: [fatherId], references: [id], onDelete: SetNull)
  childrenAsFather FamilyMember[] @relation("FatherChildren")

  partnersA FamilyPartner[] @relation("PartnerA")
  partnersB FamilyPartner[] @relation("PartnerB")

  posX Float? @map("pos_x") // posición manual guardada, en el mismo sistema de coordenadas 800x560 del árbol
  posY Float? @map("pos_y")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  linkedUserId String?  @map("linked_user_id")
  linkedUser   User?    @relation("FamilyLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  // Propuesta de etiquetado esperando respuesta — el vínculo real (arriba)
  // solo se completa cuando la otra persona acepta
  linkPendienteUserId String?   @map("link_pendiente_user_id")
  linkPropuestoEn     DateTime? @map("link_propuesto_en")

  // "Copiar árbol": de qué fila (de OTRO árbol) es copia esta — sirve para
  // no duplicar nunca al volver a copiar, y para saber qué es nuevo
  copiedFromId String?         @map("copied_from_id")
  copiedFrom   FamilyMember?   @relation("CopiedFrom", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copiasDeEste FamilyMember[]  @relation("CopiedFrom")

  @@index([ownerId])
  @@map("family_members")
}

model FamilyPartner {
  id        String   @id @default(uuid())
  memberAId String   @map("member_a_id")
  memberA   FamilyMember @relation("PartnerA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberBId String   @map("member_b_id")
  memberB   FamilyMember @relation("PartnerB", fields: [memberBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([memberAId, memberBId])
  @@map("family_partners")
}

enum ConnectionStatus {
  pending
  accepted
  rejected
}

enum RelationType {
  pareja
  padre
  madre
  hijo
  hermano
  abuelo
  primo
  familiar
  amigo
  conocido
  companero
  colega
}

enum CommentPrivacy {
  everyone
  connections
  nobody
}

model Connection {
  id          String   @id @default(uuid())
  requesterId String   @map("requester_id")
  requester   User     @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String   @map("addressee_id")
  addressee   User     @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status      ConnectionStatus @default(pending)
  createdAt   DateTime @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  // ── Tipo de vínculo (solo tiene sentido una vez aceptada la conexión) ──
  relationType             RelationType @default(amigo) @map("relation_type")
  relationTypePendiente    RelationType? @map("relation_type_pendiente")
  relationTypePropuestoPor String?       @map("relation_type_propuesto_por")
  relationTypePropuestoEn  DateTime?     @map("relation_type_propuesto_en")
  relationTypeRechazadoEn  DateTime?     @map("relation_type_rechazado_en")

  @@unique([requesterId, addresseeId])
  @@map("connections")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id")
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

enum ReactionType {
  emocionante // 💖
  inspirador  // 🍃
  recordare   // 📖 "lo recordaré"
  conmueve    // 😢 "me conmueve"
  divierte    // 😄 "me divierte"
}

model MemoryReaction {
  id        String       @id @default(uuid())
  memoryId  String       @map("memory_id")
  memory    Memory       @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([memoryId, userId]) // una persona solo puede tener UNA reacción activa por recuerdo
  @@map("memory_reactions")
}

model MemoryComment {
  id        String   @id @default(uuid())
  memoryId  String   @map("memory_id")
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at") // si no es null, se muestra "(editado)"

  // Un solo nivel de anidamiento: las respuestas a una respuesta también
  // cuelgan de la raíz — el "a quién le respondiste" se resuelve en el
  // service (para la notificación puntual), no acá en el modelo.
  parentId  String?         @map("parent_id")
  parent    MemoryComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   MemoryComment[] @relation("CommentReplies")

  // a quién le respondiste puntualmente (no necesariamente la raíz del
  // hilo) — solo para poder linkear la etiqueta "@Nombre" a su perfil
  replyToUserId String? @map("reply_to_user_id")

  reactions CommentReaction[]
  hiddenBy  HiddenComment[] @relation("HiddenByUsers")

  @@index([memoryId, createdAt])
  @@index([parentId])
  @@map("memory_comments")
}

model CommentReaction {
  id        String       @id @default(uuid())
  commentId String       @map("comment_id")
  comment   MemoryComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([commentId, userId])
  @@map("comment_reactions")
}

model Chapter {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

   nombre    String
  desde     Int      // año, ej: 1989
  hasta     Int      // año, ej: 2001
  color     String   // hex, ej: #7EC8E3
  emoji     String   @default("📖")

    memories  Memory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([ownerId])
  @@map("chapters")
}

enum ReportEntityType {
  memory
  comment
  user
  message
}

enum ReportReason {
  spam
  contenido_inapropiado
  acoso
  discurso_odio
  violencia
  desnudez_sexual
  informacion_falsa
  suplantacion
  otro
}

enum ReportStatus {
  pending
  reviewed
  actioned
  dismissed
}

model Report {
  id          String           @id @default(uuid())
  reporterId  String           @map("reporter_id")
  reporter    User             @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  entityType  ReportEntityType @map("entity_type")
  entityId    String           @map("entity_id")

  reason      ReportReason
  detalle     String?          // texto libre, solo se usa si reason = "otro"

  status      ReportStatus     @default(pending)

  // Clasificación automática (OpenAI Moderation) — se calcula al crear el
  // reporte, para que el día que exista panel de moderación humano, ya
  // llegue pre-priorizado por severidad, sin tener que reprocesar nada.
  aiFlagged    Boolean         @default(false) @map("ai_flagged")
  aiCategories String[]        @default([]) @map("ai_categories")
  aiScore      Float?          @map("ai_score")

  createdAt   DateTime         @default(now()) @map("created_at")
  reviewedAt  DateTime?        @map("reviewed_at")

  @@unique([reporterId, entityType, entityId])
  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@map("reports")
}

model HiddenMemory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation("HiddenMemoriesByUser", fields: [userId], references: [id], onDelete: Cascade)
  memoryId  String   @map("memory_id")
  memory    Memory   @relation("HiddenByUsers", fields: [memoryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, memoryId])
  @@map("hidden_memories")
}

model Mute {
  id        String    @id @default(uuid())
  muterId   String    @map("muter_id")
  muter     User      @relation("MutesMade", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId   String    @map("muted_id")
  muted     User      @relation("MutedBy", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@unique([muterId, mutedId])
  @@map("mutes")
}

model SavedMemory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation("SavedMemoriesByUser", fields: [userId], references: [id], onDelete: Cascade)
  memoryId  String   @map("memory_id")
  memory    Memory   @relation("SavedByUsers", fields: [memoryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, memoryId])
  @@map("saved_memories")
}

model HiddenComment {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  user      User          @relation("HiddenCommentsByUser", fields: [userId], references: [id], onDelete: Cascade)
  commentId String        @map("comment_id")
  comment   MemoryComment @relation("HiddenByUsers", fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([userId, commentId])
  @@map("hidden_comments")
}

// ════════════════════════════════════════════════════════════
// CHAT — Fase 1: 1 a 1, con solicitud de mensaje. La tabla de
// participantes está pensada desde ya para admitir grupos más
// adelante (Fase 4) sin tener que rediseñar nada — ahí solo se
// permitirán más de 2 filas por conversación.
// ════════════════════════════════════════════════════════════

enum ParticipantStatus {
  pending   // todavía no respondió (solicitud de mensaje)
  accepted
  rejected
  blocked   // bloqueó esta conversación puntual, sin bloquear a la persona
  left      // se fue de un grupo (Fase 4)
}

enum ParticipantRole {
  member
  admin // para grupos (Fase 4)
}

model Conversation {
  id          String    @id @default(uuid())
  isGroup     Boolean   @default(false) @map("is_group")
  name        String?   // solo grupos
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at") // para ordenar la bandeja por última actividad

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String            @id @default(uuid())
  conversationId String            @map("conversation_id")
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     ParticipantStatus @default(pending)
  isSpam     Boolean           @default(false) @map("is_spam")
  isPinned   Boolean           @default(false) @map("is_pinned")
  mutedUntil DateTime?         @map("muted_until")
  lastReadAt DateTime?         @map("last_read_at")
  role       ParticipantRole   @default(member)
  joinedAt   DateTime          @default(now()) @map("joined_at")

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content        String?  @db.Text
  // preparado para Fase 2/3 — todavía sin usar
  attachmentKey      String?  @map("attachment_key")
  attachmentType     String?  @map("attachment_type") // 'image' | 'voice' | 'gif' | 'sticker'
  attachmentDuration Int?     @map("attachment_duration") // segundos, solo para audios
  replyToId      String?  @map("reply_to_id")
  replyTo        Message? @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[] @relation("MessageReply")
  isPinned       Boolean  @default(false) @map("is_pinned")
  isDeleted      Boolean  @default(false) @map("is_deleted")

  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   // Fase 2 — set fijo de 6-7 emojis, validado en el backend
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([messageId, userId])
  @@map("message_reactions")
}