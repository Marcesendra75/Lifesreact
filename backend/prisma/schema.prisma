// Configuración de Prisma: generador de cliente + conexión a la base
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Nivel de membresía del usuario (gratis vs. planes pagos)
enum MembershipLevel {
  bronze
  silver
  gold
  diamond
}

model User {
  id        String   @id @default(uuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  // acá va el hash de bcrypt, nunca la contraseña en texto plano
  passwordHash String  @map("password_hash")

  avatarUrl String?  @map("avatar_url")
  coverUrl  String?  @map("cover_url")
  bio       String?
  birthDate DateTime? @map("birth_date") @db.Date
  country   String?
  city      String?

  membershipLevel MembershipLevel @default(bronze) @map("membership_level")
  isVerified      Boolean         @default(false) @map("is_verified")
  isActive        Boolean         @default(true)  @map("is_active")
  isPrivate       Boolean         @default(false) @map("is_private")
  commentPrivacy  CommentPrivacy  @default(everyone) @map("comment_privacy")
  termsAcceptedAt DateTime?       @map("terms_accepted_at")

  // recuperación de contraseña: token random + vencimiento, nunca guardamos la nueva sin hashear
  resetToken     String?   @map("reset_token")
  resetTokenExp  DateTime? @map("reset_token_exp")

  verificationToken    String?   @map("verification_token")
  verificationTokenExp DateTime? @map("verification_token_exp")

  // para el rate limiting / bloqueo por fuerza bruta que pediste
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // ── relaciones ──
  memories  Memory[]
  familyMembers FamilyMember[]
  connectionsSent      Connection[]    @relation("ConnectionRequester")
  connectionsReceived  Connection[]    @relation("ConnectionAddressee")
  blocksMade           Block[]         @relation("BlockerRelation")
  blocksReceived       Block[]         @relation("BlockedRelation")
  notificationsRecibidas Notification[] @relation("NotificationRecipient")
  notificationsGeneradas Notification[] @relation("NotificationActor")
  linkedFamilyNodes   FamilyMember[] @relation("FamilyLinkedUser")
  chapters       Chapter[]
  memoryReactions MemoryReaction[]
  memoryComments  MemoryComment[]

  @@map("users") // el nombre real de la tabla en Postgres queda en minúscula y plural, como ya tenías
}

enum NotificationType {
  connection_request
  connection_accepted
  connection_rejected
  relation_type_proposed
  relation_type_accepted
  relation_type_rejected
  relation_type_cancelled
  reaction
  comment
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType

  // el último que generó el evento — sirve para mostrar su nombre/foto
  actorId   String?          @map("actor_id")
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  // agrupamiento: si varias personas reaccionan/comentan lo mismo, en vez
  // de crear una notificación por cada una, sumamos a la misma
  actorIds    String[]       @default([]) @map("actor_ids")
  actorsCount Int            @default(1)  @map("actors_count")

  entityType String?         @map("entity_type") // "memory" | "connection"
  entityId   String?         @map("entity_id")

  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt       @map("updated_at")

  @@map("notifications")
}

enum MediaType {
  image
  video
}

model Memory {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  caption   String? @db.Text
  mediaKey  String? @map("media_key")   // el key que guarda storage.service.ts, no la URL
  mediaType MediaType? @map("media_type")

   chapterId String?  @map("chapter_id")
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  reactions MemoryReaction[]
  comments  MemoryComment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([userId, createdAt])
  @@map("memories")
}

enum Gender {
  male
  female
  other
}

model FamilyMember {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  firstName String   @map("first_name")
  lastName  String?  @map("last_name")
  gender    Gender?
  birthDate DateTime? @map("birth_date") @db.Date
  deathDate DateTime? @map("death_date") @db.Date
  photoKey  String?  @map("photo_key") // reusa el mismo storage.service.ts de Memories
  bio       String?  @db.Text

  motherId  String?  @map("mother_id")
  mother    FamilyMember?   @relation("MotherChildren", fields: [motherId], references: [id], onDelete: SetNull)
  childrenAsMother FamilyMember[] @relation("MotherChildren")

  fatherId  String?  @map("father_id")
  father    FamilyMember?   @relation("FatherChildren", fields: [fatherId], references: [id], onDelete: SetNull)
  childrenAsFather FamilyMember[] @relation("FatherChildren")

  partnersA FamilyPartner[] @relation("PartnerA")
  partnersB FamilyPartner[] @relation("PartnerB")

  posX Float? @map("pos_x") // posición manual guardada, en el mismo sistema de coordenadas 800x560 del árbol
  posY Float? @map("pos_y")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  linkedUserId String?  @map("linked_user_id")
  linkedUser   User?    @relation("FamilyLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("family_members")
}

model FamilyPartner {
  id        String   @id @default(uuid())
  memberAId String   @map("member_a_id")
  memberA   FamilyMember @relation("PartnerA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberBId String   @map("member_b_id")
  memberB   FamilyMember @relation("PartnerB", fields: [memberBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([memberAId, memberBId])
  @@map("family_partners")
}

enum ConnectionStatus {
  pending
  accepted
  rejected
}

enum RelationType {
  pareja
  padre
  madre
  hijo
  hermano
  abuelo
  primo
  familiar
  amigo
  conocido
  companero
  colega
}

enum CommentPrivacy {
  everyone
  connections
  nobody
}

model Connection {
  id          String   @id @default(uuid())
  requesterId String   @map("requester_id")
  requester   User     @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String   @map("addressee_id")
  addressee   User     @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status      ConnectionStatus @default(pending)
  createdAt   DateTime @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  // ── Tipo de vínculo (solo tiene sentido una vez aceptada la conexión) ──
  relationType             RelationType @default(amigo) @map("relation_type")
  relationTypePendiente    RelationType? @map("relation_type_pendiente")
  relationTypePropuestoPor String?       @map("relation_type_propuesto_por")
  relationTypePropuestoEn  DateTime?     @map("relation_type_propuesto_en")
  relationTypeRechazadoEn  DateTime?     @map("relation_type_rechazado_en")

  @@unique([requesterId, addresseeId])
  @@map("connections")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id")
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

enum ReactionType {
  emocionante // 💖
  inspirador  // 🍃
  recordare   // 📖 "lo recordaré"
  conmueve    // 😢 "me conmueve"
}

model MemoryReaction {
  id        String       @id @default(uuid())
  memoryId  String       @map("memory_id")
  memory    Memory       @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([memoryId, userId]) // una persona solo puede tener UNA reacción activa por recuerdo
  @@map("memory_reactions")
}

model MemoryComment {
  id        String   @id @default(uuid())
  memoryId  String   @map("memory_id")
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([memoryId, createdAt])
  @@map("memory_comments")
}

model Chapter {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

   nombre    String
  desde     Int      // año, ej: 1989
  hasta     Int      // año, ej: 2001
  color     String   // hex, ej: #7EC8E3
  emoji     String   @default("📖")

    memories  Memory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([ownerId])
  @@map("chapters")
}